# 后端监听端口
PORT=3000

# 以下变量只在 backend/.env 中填写真实值，不要提交到 Git。
# 填写模型平台提供的 OpenAI 兼容 API 基础地址，通常以 /v1 结尾。
MODEL_BASE_URL=
# 填写平台显示的完整模型 ID，不要填写界面展示名称。
MODEL_NAME=
# 系统提示词保存在后端文件中，前端无法访问。
MODEL_SYSTEM_PROMPT_FILE=config/system-prompt.txt
# 最大回复长度，后端会限制在 1 到 512 tokens。
MODEL_MAX_TOKENS=256
# 默认温度。当前模型按 0 到 1 验证；Thinking 模式可能要求 1。
MODEL_TEMPERATURE=1
# 只在本文件中填写，不要放入前端、源代码、日志或聊天。
MODEL_API_KEY=

# Supabase 项目地址与可公开的 Publishable/Anon Key。
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Secret/Service Key 只允许在后端使用，不参与普通数据请求。
SUPABASE_SECRET_KEY=
# 本地开发使用 false；部署到 HTTPS 后改为 true。
AUTH_COOKIE_SECURE=false

# 用于加密用户输入的官方供应商 API Key，必须由后端保存。
CREDENTIAL_ENCRYPTION_KEY=
